__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.jspace/
.venv/
output/*.csv
output/*.json
output/runs/
output/shadow/
output/research/
state/*
!output/.gitkeep
!state/.gitkeep
# CSR-8 / research runtime data tree — never tracked (real production
# chain, secrets, ingest pools, market-data caches). The one tracked file
# data/t4/sector_map/csrc_industry_snapshot.json stays tracked.
data/
# Source package directory named data is code, not runtime market data.
!src/stock_selector/data/
!src/stock_selector/data/**
# 但上面的放行会连带把该目录下的编译缓存也捞进来，重新挡掉
src/stock_selector/data/__pycache__/

# Batch-H reviewer pre-spawn DSH captures (session-local, pinned by evidence records)
captures/

# EI-5P cron 运行日志
logs/
captures-archive/*
!captures-archive/*.manifest.sha256
!captures-archive/*.receipt.json
!captures-archive/*.tar.sha256
